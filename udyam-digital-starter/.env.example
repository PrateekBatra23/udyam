# Copy to .env (backend reads from environment).
# Advisor falls back to rules-only if LLM_API_KEY is unset.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
DATA_DIR=../data

# PostgreSQL (orders + consent receipts persist here)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udyam

# Only if Tesseract cannot find its language data (e.g. a conda install on Windows)
# TESSDATA_PREFIX=/path/to/tessdata
